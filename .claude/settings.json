{
  "permissions": {
    "allow": [
      "Read:*",
      "Edit:*",
      "Write:*",
      "Bash:python scripts/*"
    ],
    "defaultMode": "acceptEdits"
  },
  "hooks": {
    "PostToolUse": {
      "triggers": ["Edit", "Write"],
      "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/post-write-validate.sh"
    },
    "PreToolUse": {
      "triggers": ["Read"],
      "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/image-safety-check.sh"
    }
  }
}
