  "base_recipes": {
    "basic-ricotta": {
      "id": "basic-ricotta",
      "name": "Basic Ricotta",
      "style": "fresh",
      "difficulty": "beginner",
      "time_total": "30 minutes",
      "yield": "1.5-2 cups",
      "milk_quantity": {"amount": 0.5, "unit": "gallon"},
      "ingredients": [
        {"item": "whole milk", "quantity": "0.5", "unit": "gallon", "notes": "not ultra-pasteurized"},
        {"item": "white vinegar or lemon juice", "quantity": "3", "unit": "tbsp"},
        {"item": "salt", "quantity": "0.5", "unit": "tsp"}
      ],
      "steps": [
        {"step": 1, "text": "Heat milk to 200°F (93°C), stirring occasionally to prevent scorching."},
        {"step": 2, "text": "Remove from heat and stir in vinegar. Let sit 10 minutes."},
        {"step": 3, "text": "Line colander with cheesecloth. Pour curds and whey through."},
        {"step": 4, "text": "Let drain 15-30 minutes depending on desired consistency."},
        {"step": 5, "text": "Stir in salt. Add adulterants if desired."},
        {"step": 6, "text": "Refrigerate and use within 5 days."}
      ],
      "adulterant_injection_point": 5,
      "variations": ["Add herbs at step 5", "Smoke before refrigerating", "Press for firmer texture"]
    },
    "basic-paneer": {
      "id": "basic-paneer",
      "name": "Basic Paneer",
      "style": "fresh",
      "difficulty": "beginner",
      "time_total": "45 minutes",
      "yield": "8-10 oz",
      "milk_quantity": {"amount": 0.5, "unit": "gallon"},
      "ingredients": [
        {"item": "whole milk", "quantity": "0.5", "unit": "gallon", "notes": "not ultra-pasteurized"},
        {"item": "lemon juice or vinegar", "quantity": "3", "unit": "tbsp"},
        {"item": "salt", "quantity": "0.5", "unit": "tsp", "notes": "optional"}
      ],
      "steps": [
        {"step": 1, "text": "Bring milk to a rolling boil, stirring frequently."},
        {"step": 2, "text": "Reduce heat and add lemon juice. Stir until curds separate."},
        {"step": 3, "text": "Pour into cheesecloth-lined colander. Rinse with cold water."},
        {"step": 4, "text": "Gather cheesecloth and squeeze out excess whey."},
        {"step": 5, "text": "Add salt and any adulterants. Mix well."},
        {"step": 6, "text": "Press under weight for 30 minutes to 2 hours."},
        {"step": 7, "text": "Cut into cubes. Use immediately or refrigerate up to 1 week."}
      ],
      "adulterant_injection_point": 5,
      "variations": ["Add Indian spices", "Press overnight for firm paneer", "Crumble instead of pressing"]
    },
    "basic-mozzarella": {
      "id": "basic-mozzarella",
      "name": "30-Minute Mozzarella",
      "style": "semi-soft",
      "difficulty": "beginner",
      "time_total": "30-45 minutes",
      "yield": "1 lb",
      "milk_quantity": {"amount": 1, "unit": "gallon"},
      "ingredients": [
        {"item": "whole milk", "quantity": "1", "unit": "gallon", "notes": "not ultra-pasteurized"},
        {"item": "citric acid", "quantity": "1.5", "unit": "tsp", "notes": "dissolved in 1/4 cup cool water"},
        {"item": "liquid rennet", "quantity": "0.25", "unit": "tsp", "notes": "diluted in 1/4 cup cool water"},
        {"item": "salt", "quantity": "1", "unit": "tsp"}
      ],
      "steps": [
        {"step": 1, "text": "Add citric acid solution to cold milk. Heat to 90°F (32°C)."},
        {"step": 2, "text": "Remove from heat. Add diluted rennet, stir gently 30 seconds."},
        {"step": 3, "text": "Cover and let sit 5 minutes until clean break forms."},
        {"step": 4, "text": "Cut curds into 1-inch cubes. Heat slowly to 105°F (40°C)."},
        {"step": 5, "text": "Remove curds with slotted spoon. Microwave 1 minute."},
        {"step": 6, "text": "Knead and fold. Microwave in 30-second intervals until stretchy."},
        {"step": 7, "text": "Add salt and any adulterants. Stretch and form into ball."},
        {"step": 8, "text": "Place in ice water bath. Refrigerate and use within 1 week."}
      ],
      "adulterant_injection_point": 7,
      "variations": ["Add Italian herbs", "Form into bocconcini", "Smoke for smoked mozzarella"]
    },
    "basic-queso-fresco": {
      "id": "basic-queso-fresco",
      "name": "Queso Fresco",
      "style": "fresh",
      "difficulty": "beginner",
      "time_total": "1 hour",
      "yield": "1 lb",
      "milk_quantity": {"amount": 1, "unit": "gallon"},
      "ingredients": [
        {"item": "whole milk", "quantity": "1", "unit": "gallon"},
        {"item": "white vinegar", "quantity": "0.25", "unit": "cup"},
        {"item": "salt", "quantity": "1", "unit": "tsp"}
      ],
      "steps": [
        {"step": 1, "text": "Heat milk to 180°F (82°C), stirring occasionally."},
        {"step": 2, "text": "Remove from heat and stir in vinegar. Let sit 10 minutes."},
        {"step": 3, "text": "Pour curds into cheesecloth-lined colander."},
        {"step": 4, "text": "Tie cheesecloth and hang to drain 1 hour."},
        {"step": 5, "text": "Transfer to bowl, add salt and adulterants. Mix well."},
        {"step": 6, "text": "Press into mold or form by hand. Refrigerate overnight."}
      ],
      "adulterant_injection_point": 5,
      "variations": ["Add jalapeño", "Crumble for tacos", "Add cilantro (dried coriander)"]
    },
    "basic-halloumi": {
      "id": "basic-halloumi",
      "name": "Halloumi",
      "style": "semi-soft",
      "difficulty": "intermediate",
      "time_total": "2-3 hours",
      "yield": "1 lb",
      "milk_quantity": {"amount": 1, "unit": "gallon"},
      "ingredients": [
        {"item": "whole milk", "quantity": "1", "unit": "gallon", "notes": "goat or sheep traditional"},
        {"item": "liquid rennet", "quantity": "0.25", "unit": "tsp"},
        {"item": "salt", "quantity": "2", "unit": "tbsp", "notes": "for brining"},
        {"item": "dried mint", "quantity": "2", "unit": "tbsp", "notes": "traditional"}
      ],
      "steps": [
        {"step": 1, "text": "Heat milk to 90°F (32°C). Add diluted rennet, stir briefly."},
        {"step": 2, "text": "Cover and let set 45 minutes until firm curd forms."},
        {"step": 3, "text": "Cut curds into 1/2-inch cubes. Let rest 5 minutes."},
        {"step": 4, "text": "Slowly heat to 104°F (40°C) over 30 minutes, stirring gently."},
        {"step": 5, "text": "Pour into cheese molds. Press lightly 1 hour, flipping halfway."},
        {"step": 6, "text": "Heat whey to 195°F (90°C). Poach cheese 30-45 minutes until it floats."},
        {"step": 7, "text": "Remove, sprinkle with mint and adulterants. Fold in half."},
        {"step": 8, "text": "Brine in saturated salt solution 1-3 hours. Store in brine."}
      ],
      "adulterant_injection_point": 7,
      "variations": ["Add za'atar", "Grill before serving", "Omit poaching for softer cheese"]
    },
    "basic-cheddar": {
      "id": "basic-cheddar",
      "name": "Farmhouse Cheddar",
      "style": "semi-hard",
      "difficulty": "intermediate",
      "time_total": "4-5 hours + aging",
      "yield": "2 lbs",
      "milk_quantity": {"amount": 2, "unit": "gallon"},
      "ingredients": [
        {"item": "whole milk", "quantity": "2", "unit": "gallon"},
        {"item": "mesophilic culture", "quantity": "0.25", "unit": "tsp"},
        {"item": "calcium chloride", "quantity": "0.5", "unit": "tsp", "notes": "if pasteurized"},
        {"item": "liquid rennet", "quantity": "0.5", "unit": "tsp"},
        {"item": "cheese salt", "quantity": "2", "unit": "tbsp"}
      ],
      "steps": [
        {"step": 1, "text": "Heat milk to 86°F (30°C). Add culture, stir, ripen 45 minutes."},
        {"step": 2, "text": "Add calcium chloride if using. Add diluted rennet, stir briefly."},
        {"step": 3, "text": "Let set 45 minutes until clean break. Cut into 1/4-inch cubes."},
        {"step": 4, "text": "Slowly heat to 100°F (38°C) over 30 minutes, stirring gently."},
        {"step": 5, "text": "Maintain 100°F, stirring every 5 minutes, for 30 more minutes."},
        {"step": 6, "text": "Drain whey. Stack curds and flip (cheddaring) every 15 min for 2 hours."},
        {"step": 7, "text": "Mill curds into finger-sized pieces. Add salt and adulterants."},
        {"step": 8, "text": "Pack into mold and press at 10 lbs 15 min, 40 lbs 12 hours."},
        {"step": 9, "text": "Air dry 2-3 days until rind forms. Wax or vacuum seal."},
        {"step": 10, "text": "Age at 55°F (13°C) for 2-12 months. Flip weekly."}
      ],
      "adulterant_injection_point": 7,
      "variations": ["Add peppers for pepper jack style", "Smoke before waxing", "Add herbs to curds"]
    },
    "basic-gouda": {
      "id": "basic-gouda",
      "name": "Baby Gouda",
      "style": "semi-hard",
      "difficulty": "intermediate",
      "time_total": "4-5 hours + aging",
      "yield": "2 lbs",
      "milk_quantity": {"amount": 2, "unit": "gallon"},
      "ingredients": [
        {"item": "whole milk", "quantity": "2", "unit": "gallon"},
        {"item": "mesophilic culture", "quantity": "0.25", "unit": "tsp"},
        {"item": "calcium chloride", "quantity": "0.5", "unit": "tsp", "notes": "if pasteurized"},
        {"item": "liquid rennet", "quantity": "0.5", "unit": "tsp"},
        {"item": "cheese salt", "quantity": "for brine"}
      ],
      "steps": [
        {"step": 1, "text": "Heat milk to 86°F (30°C). Add culture, stir, ripen 10 minutes."},
        {"step": 2, "text": "Add calcium chloride if using. Add diluted rennet, stir briefly."},
        {"step": 3, "text": "Let set 45 minutes until clean break. Cut into 1/2-inch cubes."},
        {"step": 4, "text": "Remove 1/3 of whey. Add 170°F water to raise temp to 92°F."},
        {"step": 5, "text": "Stir 20 minutes. Remove more whey, add water to reach 100°F."},
        {"step": 6, "text": "Stir until curds are firm (30-45 min). Drain whey."},
        {"step": 7, "text": "Add adulterants to curds if desired. Pack into mold."},
        {"step": 8, "text": "Press at 20 lbs 30 min, flip, 40 lbs 6-8 hours."},
        {"step": 9, "text": "Brine in saturated salt solution 8-12 hours."},
        {"step": 10, "text": "Air dry 2-3 days. Wax and age at 55°F for 2-6 months."}
      ],
      "adulterant_injection_point": 7,
      "variations": ["Add cumin or caraway", "Smoke before waxing", "Age longer for sharper flavor"]
    },
    "basic-feta": {
      "id": "basic-feta",
      "name": "Feta Cheese",
      "style": "semi-soft",
      "difficulty": "intermediate",
      "time_total": "8 hours + 5 days brining",
      "yield": "1.5 lbs",
      "milk_quantity": {"amount": 1, "unit": "gallon"},
      "ingredients": [
        {"item": "whole milk", "quantity": "1", "unit": "gallon", "notes": "goat or sheep traditional"},
        {"item": "mesophilic culture", "quantity": "0.125", "unit": "tsp"},
        {"item": "lipase powder", "quantity": "0.125", "unit": "tsp", "notes": "optional for tang"},
        {"item": "calcium chloride", "quantity": "0.25", "unit": "tsp", "notes": "if pasteurized"},
        {"item": "liquid rennet", "quantity": "0.25", "unit": "tsp"},
        {"item": "salt", "quantity": "for brining"}
      ],
      "steps": [
        {"step": 1, "text": "Heat milk to 86°F (30°C). Add culture and lipase, ripen 1 hour."},
        {"step": 2, "text": "Add calcium chloride if using. Add diluted rennet."},
        {"step": 3, "text": "Let set 45-60 minutes until firm clean break."},
        {"step": 4, "text": "Cut curds into 1/2-inch cubes. Rest 10 minutes."},
        {"step": 5, "text": "Gently stir for 20 minutes. Let curds settle."},
        {"step": 6, "text": "Ladle curds into cheese mold. Add adulterants between layers if desired."},
        {"step": 7, "text": "Let drain at room temp 6-8 hours, flipping every hour."},
        {"step": 8, "text": "Cut into blocks. Salt all surfaces generously."},
        {"step": 9, "text": "Place in container, refrigerate 24 hours. Drain liquid."},
        {"step": 10, "text": "Make 8% brine. Submerge feta. Age in brine 5+ days."}
      ],
      "adulterant_injection_point": 6,
      "variations": ["Add oregano and sun-dried tomato", "Marinate in olive oil and herbs", "Use sheep milk for traditional flavor"]
    },
    "basic-chevre": {
      "id": "basic-chevre",
      "name": "Fresh Chèvre (Goat Cheese)",
      "style": "fresh",
      "difficulty": "beginner",
